{
  "version": 1,
  "publication": {
    "path": "src/{publication}/publication.yml",
    "schema": "publication.schema.json"
  },
  "families": [
    { "id": "action", "directory": "action", "layout": "flat", "schema": "character-action.schema.json" },
    { "id": "spell", "directory": "spell", "layout": "flat", "schema": "character-spell.schema.json" },
    { "id": "item", "directory": "item", "layout": "flat", "schema": "character-item.schema.json" },
    { "id": "background", "directory": "background", "layout": "flat", "schema": "character-background.schema.json" },
    { "id": "feat", "directory": "feat", "layout": "flat", "schema": "character-feat.schema.json" },
    {
      "id": "ancestry",
      "directory": "ancestry",
      "layout": "bundle",
      "schema": "character-ancestry.schema.json",
      "children": [
        { "directory": "features", "layout": "flat", "schema": "character-feature.schema.json" }
      ]
    },
    {
      "id": "class",
      "directory": "class",
      "layout": "bundle",
      "schema": "character-class.schema.json",
      "children": [
        { "directory": "features", "layout": "flat", "schema": "character-feature.schema.json" },
        { "directory": "schools", "layout": "flat", "schema": "character-feature.schema.json" },
        { "directory": "basic-lessons", "layout": "flat", "schema": "character-feature.schema.json" },
        { "directory": "greater-lessons", "layout": "flat", "schema": "character-feature.schema.json" },
        { "directory": "major-lessons", "layout": "flat", "schema": "character-feature.schema.json" }
      ],
      "allowsCustomChildren": true,
      "customChildSchema": "character-feature.schema.json"
    },
    {
      "id": "archetype",
      "directory": "archetype",
      "layout": "bundle",
      "schema": "character-archetype.schema.json",
      "children": [
        { "directory": "feats", "layout": "flat", "schema": "character-feat.schema.json" }
      ]
    },
    { "id": "domain", "directory": "domain", "layout": "flat", "schema": "character-domain.schema.json" },
    { "id": "companion", "directory": "companion", "layout": "flat", "schema": "character-companion.schema.json" },
    { "id": "heritage", "directory": "heritage", "layout": "grouped", "schema": "character-heritage.schema.json" }
  ],
  "customGroups": [
    { "familyID": "class", "ownerPath": ["bard"], "directory": "muses", "schema": "character-feature.schema.json" },
    { "familyID": "class", "ownerPath": ["cleric"], "directory": "doctrines", "schema": "character-feature.schema.json" },
    { "familyID": "class", "ownerPath": ["druid"], "directory": "orders", "schema": "character-feature.schema.json" },
    { "familyID": "class", "ownerPath": ["ranger"], "directory": "hunters-edge", "schema": "character-feature.schema.json" },
    { "familyID": "class", "ownerPath": ["rogue"], "directory": "rackets", "schema": "character-feature.schema.json" },
    { "familyID": "class", "ownerPath": ["witch"], "directory": "patrons", "schema": "character-feature.schema.json" },
    { "familyID": "class", "ownerPath": ["wizard"], "directory": "theses", "schema": "character-feature.schema.json" }
  ]
}
