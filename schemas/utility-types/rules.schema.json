{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/utility-types/rules.schema.json",
  "title": "Character Rules",
  "description": "Schema for archive-authored character rules and mechanics registry inputs",
  "$defs": {
    "rule": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "Readable stable member identity for a rule; its id is derived from the record path and this key"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "The level the rule starts at; 1 when left out"
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prerequisite"
              }
            },
            "effect": {
              "$ref": "#/$defs/effectName"
            },
            "inputs": {
              "$ref": "#/$defs/inputs"
            }
          },
          "required": [
            "id",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "Readable stable member identity for a rule; its id is derived from the record path and this key"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "The level the rule starts at; 1 when left out"
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prerequisite"
              }
            },
            "choice": {
              "$ref": "#/$defs/choice"
            }
          },
          "required": [
            "id",
            "choice"
          ],
          "additionalProperties": false
        }
      ]
    },
    "recordReference": {
      "description": "A record: @family.name[.collection.name]*, then an optional #member and ?source= (Proposal K). Without ?source= it is the file's own publication's record.",
      "type": "string",
      "pattern": "^@[^\\s#?]+(?:#[^\\s?]+)?(?:\\?source=[a-z0-9-]+)?$"
    },
    "choice": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/choiceDefinitionName"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Only when it differs from the rule's level"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choiceName"
          }
        },
        "distinctFrom": {
          "description": "Choices whose picks this choice's options leave out.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/choiceName"
          }
        },
        "legacySelections": {
          "description": "Original slot coordinates used only for one-time character package migration.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacySelection"
          }
        },
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choiceCase"
          }
        },
        "records": {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "resource-filter.schema.json"
            },
            "type": {
              "$ref": "#/$defs/typeName"
            }
          },
          "required": [
            "filter",
            "type"
          ],
          "additionalProperties": false
        },
        "freeText": {
          "$ref": "#/$defs/typeName"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "oneOf": [
        {
          "required": [
            "cases"
          ]
        },
        {
          "required": [
            "records"
          ]
        },
        {
          "required": [
            "freeText"
          ]
        }
      ],
      "additionalProperties": false
    },
    "choiceCase": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Left out when it is the value's own text"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Left out when it is the key's words capitalized"
        },
        "value": {
          "description": "A bare literal of the choice's type; a record is an @ reference"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effectEntry"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "effects"
            ]
          }
        },
        {
          "required": [
            "effects"
          ],
          "not": {
            "required": [
              "value"
            ]
          },
          "anyOf": [
            {
              "required": [
                "key"
              ]
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "legacySelection": {
      "type": "object",
      "properties": {
        "ruleID": {
          "type": "string",
          "format": "uuid"
        },
        "inputName": {
          "type": "string",
          "minLength": 1
        },
        "lookupName": {
          "$ref": "#/$defs/legacyLookupName"
        },
        "valueTypeID": {
          "$ref": "#/$defs/valueTypeID"
        },
        "sourceID": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "ruleID",
        "inputName",
        "lookupName",
        "valueTypeID"
      ],
      "additionalProperties": false
    },
    "choiceName": {
      "description": "A choice read path: a namespaced content path, the shared deity group, or a supported engine read.",
      "type": "string",
      "anyOf": [
        {
          "pattern": "^\\$\\.(?:level|attributes\\.(?:str|dex|con|int|wis|cha))$"
        },
        {
          "pattern": "^\\$\\.(?!level(?:\\.|$)|attributes(?:\\.|$))(?:[a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "const": "$.deity"
        }
      ]
    },
    "legacyChoiceName": {
      "description": "A deprecated hasChoice name retained for unrevised resources; new choice reads use a namespaced choiceName.",
      "anyOf": [
        {
          "$ref": "#/$defs/choiceName"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ]
    },
    "legacyLookupName": {
      "description": "A legacy lookup/selection name. These names are retained only while archive resources are rewritten to named-choice paths.",
      "type": "string",
      "minLength": 1
    },
    "choiceDefinitionName": {
      "description": "A namespaced content choice definition, except the shared `$.deity` group; engine roots are reserved for reads.",
      "type": "string",
      "anyOf": [
        {
          "const": "$.deity"
        },
        {
          "pattern": "^\\$\\.(?!level(?:\\.|$)|attributes(?:\\.|$))(?:[a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ]
    },
    "prerequisite": {
      "oneOf": [
        {
          "type": "object",
          "description": "No archive use. Kept until its callers and saved packages are checked; a removal candidate (0145).",
          "properties": {
            "hasClassTrait": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "hasClassTrait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "No archive use. Kept as the generic level check that 0107 may need (0145).",
          "properties": {
            "hasLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "hasLevel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "No archive use. Kept until its callers and saved packages are checked; a removal candidate (0145).",
          "properties": {
            "hasAncestryWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasAncestryWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasClassWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasClassWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasTrait": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasTrait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasFeatWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatureWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasFeatureWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasResourceWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasResourceWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "No archive use. A score check kept to read older data; the remaster uses hasAttributeModifier, so new content doesn't author it, and the bridge's legacy text path is its only producer (0145).",
          "properties": {
            "hasAttribute": {
              "type": "object",
              "properties": {
                "attribute": {
                  "$ref": "#/$defs/prerequisiteAttribute"
                },
                "score": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                }
              },
              "required": [
                "attribute",
                "score"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasAttribute"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAttributeModifier": {
              "type": "object",
              "properties": {
                "attribute": {
                  "$ref": "#/$defs/prerequisiteAttribute"
                },
                "modifier": {
                  "type": "integer",
                  "minimum": -5,
                  "maximum": 20
                }
              },
              "required": [
                "attribute",
                "modifier"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasAttributeModifier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSkillProficiency": {
              "type": "object",
              "properties": {
                "skill": {
                  "$ref": "#/$defs/prerequisiteSkill"
                },
                "proficiency": {
                  "$ref": "proficiency-rank.schema.json"
                }
              },
              "required": [
                "skill",
                "proficiency"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasSkillProficiency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSavingThrowProficiency": {
              "type": "object",
              "properties": {
                "savingThrow": {
                  "$ref": "saving-throw.schema.json"
                },
                "proficiency": {
                  "$ref": "proficiency-rank.schema.json"
                }
              },
              "required": [
                "savingThrow",
                "proficiency"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasSavingThrowProficiency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSpellcasting": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "hasSpellcasting"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "No archive use. Kept as the generic access check that 0107 may need (0145).",
          "properties": {
            "hasAccess": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasAccess"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "The chosen ancestry's record states this vision. A stand-in for a choice on character.ancestry.vision (Proposal I).",
          "properties": {
            "hasAncestryVision": {
              "type": "string",
              "enum": [
                "normal",
                "low-light-vision",
                "darkvision"
              ]
            }
          },
          "required": [
            "hasAncestryVision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "The character has a sense, by its selector (0143). For feat eligibility; a rule gated on it could satisfy itself (0159).",
          "properties": {
            "hasSense": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "hasSense"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prerequisite"
              },
              "minItems": 1
            }
          },
          "required": [
            "allOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "anyOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prerequisite"
              },
              "minItems": 1
            }
          },
          "required": [
            "anyOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unsupported": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "unsupported"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasChoice": {
              "description": "A choice made in a rule's selection passes one test. Within one resource it must name a choice defined by an earlier rule.",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/legacyChoiceName"
                },
                "isSet": {
                  "const": true
                },
                "equals": {
                  "$ref": "#/$defs/typedValue"
                },
                "oneOf": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/typedValue"
                  },
                  "minItems": 1
                },
                "contains": {
                  "description": "A repeatable choice holds a list, one answer per copy; one of them equals this value.",
                  "$ref": "#/$defs/typedValue"
                }
              },
              "required": [
                "name"
              ],
              "oneOf": [
                {
                  "required": [
                    "isSet"
                  ]
                },
                {
                  "required": [
                    "equals"
                  ]
                },
                {
                  "required": [
                    "oneOf"
                  ]
                },
                {
                  "required": [
                    "contains"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasChoice"
          ],
          "additionalProperties": false
        }
      ]
    },
    "valueTypeID": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/value/[a-z0-9-]+$"
    },
    "prerequisiteAttribute": {
      "type": "string",
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "prerequisiteSkill": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "acrobatics",
            "arcana",
            "athletics",
            "crafting",
            "deception",
            "diplomacy",
            "intimidation",
            "medicine",
            "nature",
            "occultism",
            "performance",
            "religion",
            "society",
            "stealth",
            "survival",
            "thievery"
          ]
        },
        {
          "type": "object",
          "properties": {
            "lore": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "lore"
          ],
          "additionalProperties": false
        }
      ]
    },
    "typeName": {
      "description": "A value type: <module alias>/<type> (core/skill), or the full ID.",
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]*/[a-z0-9-]+|[a-z0-9.-]+/value/[a-z0-9-]+)$"
    },
    "effectName": {
      "description": "An effect: <module alias>/<effect>, with @<revision> for a revision other than 1 (core/add-feat@2).",
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]*/[a-z0-9-]+|[a-z0-9.-]+/effect/[a-z0-9-]+)(?:@[0-9]+)?$"
    },
    "typedValue": {
      "description": "A value that names its type, where the context doesn't.",
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "value": {}
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "description": "Effect inputs by name. A bare value is a literal typed by the effect's descriptor (a record input takes an @ reference); {choice: $.…}, {selection: …}, {lookup: name} and {literal: …} (with an optional type:) are the explicit forms.",
      "type": "object",
      "additionalProperties": {}
    },
    "effectEntry": {
      "description": "A grant of a choice case: an effect in the same compact form, with no level.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "effect": {
          "$ref": "#/$defs/effectName"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "inputDescriptors": {
          "description": "Only when they differ from the effect's descriptor",
          "type": "array"
        }
      },
      "required": [
        "effect"
      ],
      "additionalProperties": false
    },
    "prerequisiteEntry": {
      "description": "A feat's prerequisite: its text and, next to it, its typed form (or unsupported).",
      "oneOf": [
        {
          "type": "object",
          "description": "No archive use. Kept until its callers and saved packages are checked; a removal candidate (0145).",
          "properties": {
            "hasClassTrait": {
              "type": "boolean",
              "const": true
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasClassTrait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "No archive use. Kept as the generic level check that 0107 may need (0145).",
          "properties": {
            "hasLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasLevel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "No archive use. Kept until its callers and saved packages are checked; a removal candidate (0145).",
          "properties": {
            "hasAncestryWithName": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasAncestryWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasClassWithName": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasClassWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasTrait": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasTrait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatWithName": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasFeatWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatureWithName": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "diagnostic": {
              "description": "true: the unsupported reason is also reported as a diagnostic; text: a different diagnostic",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "text",
            "hasFeatureWithName"
          ],
