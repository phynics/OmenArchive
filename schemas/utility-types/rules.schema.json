{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/utility-types/rules.schema.json",
  "title": "Character Rules",
  "description": "Schema for archive-authored character rules and mechanics registry inputs",
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "effectReference": {
          "$ref": "#/$defs/effectReference"
        },
        "inputRecipes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputRecipe"
          },
          "default": [

          ]
        },
        "startLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          },
          "default": [

          ]
        }
      },
      "required": [
        "id",
        "effectReference",
        "inputRecipes",
        "startLevel"
      ],
      "additionalProperties": false
    },
    "inputRecipe": {
      "type": "object",
      "properties": {
        "inputName": {
          "type": "string",
          "minLength": 1
        },
        "expectedValue": {
          "$ref": "#/$defs/expectedValue"
        }
      },
      "required": [
        "inputName",
        "expectedValue"
      ],
      "additionalProperties": false
    },
    "expectedValue": {
      "type": "object",
      "properties": {
        "valueTypeID": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/value/[a-z0-9-]+$"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "valueTypeID",
        "source"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/registeredValue"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "lookupByName"
            },
            "name": {
              "$ref": "#/$defs/choiceName"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "selection"
            },
            "selection": {
              "$ref": "#/$defs/selection"
            }
          },
          "required": [
            "kind",
            "selection"
          ],
          "additionalProperties": false
        }
      ]
    },
    "choiceName": {
      "description": "A selection's lookup name: kebab-case, like filenames. Rules read it with lookupByName and hasChoice, which look in their own resource first.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "selection": {
      "type": "object",
      "properties": {
        "lookupName": {
          "$ref": "#/$defs/choiceName"
        },
        "valueTypeID": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/value/[a-z0-9-]+$"
        },
        "options": {
          "$ref": "#/$defs/selectionOptions"
        },
        "distinctWithin": {
          "description": "Selections with the same group key pick different values: each leaves out the values picked by those defined before it.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$"
        }
      },
      "required": [
        "lookupName",
        "valueTypeID",
        "options"
      ],
      "additionalProperties": false
    },
    "resourceReference": {
      "type": "string",
      "pattern": "^omen://\\S+$",
      "description": "A canonical OmenPath URI, optionally qualified with ?source=<publication-id>."
    },
    "prerequisite": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hasClassTrait": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "hasClassTrait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "hasLevel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAncestryWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasAncestryWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasClassWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasClassWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasTrait": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasTrait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatWithName": {
              "type": "string"
            }
          },
          "required": [
            "hasFeatWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatureWithName": {
              "type": "string"
            }
          },
          "required": [
            "hasFeatureWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasResourceWithName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasResourceWithName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAttribute": {
              "type": "object",
              "properties": {
                "attribute": {
                  "type": "string",
                  "enum": [
                    "str",
                    "dex",
                    "con",
                    "int",
                    "wis",
                    "cha"
                  ]
                },
                "score": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                }
              },
              "required": [
                "attribute",
                "score"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasAttribute"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAttributeModifier": {
              "type": "object",
              "properties": {
                "attribute": {
                  "type": "string",
                  "enum": [
                    "str",
                    "dex",
                    "con",
                    "int",
                    "wis",
                    "cha"
                  ]
                },
                "modifier": {
                  "type": "integer",
                  "minimum": -5,
                  "maximum": 20
                }
              },
              "required": [
                "attribute",
                "modifier"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasAttributeModifier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSkillProficiency": {
              "type": "object",
              "properties": {
                "skill": {
                  "$ref": "skill.schema.json"
                },
                "proficiency": {
                  "$ref": "proficiency-rank.schema.json"
                }
              },
              "required": [
                "skill",
                "proficiency"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasSkillProficiency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSavingThrowProficiency": {
              "type": "object",
              "properties": {
                "savingThrow": {
                  "$ref": "saving-throw.schema.json"
                },
                "proficiency": {
                  "$ref": "proficiency-rank.schema.json"
                }
              },
              "required": [
                "savingThrow",
                "proficiency"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasSavingThrowProficiency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSpellcasting": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "hasSpellcasting"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAccess": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "hasAccess"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prerequisite"
              },
              "minItems": 1
            }
          },
          "required": [
            "allOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "anyOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prerequisite"
              },
              "minItems": 1
            }
          },
          "required": [
            "anyOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unsupported": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "unsupported"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasChoice": {
              "description": "A choice made in a rule's selection passes one test. Within one resource it must name a choice defined by an earlier rule.",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/choiceName"
                },
                "isSet": {
                  "const": true
                },
                "equals": {
                  "$ref": "#/$defs/registeredValue"
                },
                "oneOf": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/registeredValue"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "name"
              ],
              "oneOf": [
                {
                  "required": [
                    "isSet"
                  ]
                },
                {
                  "required": [
                    "equals"
                  ]
                },
                {
                  "required": [
                    "oneOf"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hasChoice"
          ],
          "additionalProperties": false
        }
      ]
    },
    "effectReference": {
      "type": "object",
      "properties": {
        "kindID": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/effect/[a-z0-9-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kindID",
        "revision"
      ],
      "additionalProperties": false
    },
    "registeredValue": {
      "type": "object",
      "properties": {
        "typeID": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/value/[a-z0-9-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
        }
      },
      "required": [
        "typeID",
        "revision",
        "payload"
      ],
      "additionalProperties": false
    },
    "selectionOptions": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unrestricted"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "explicit"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/registeredValue"
              }
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resourceFiltered"
            },
            "filter": {
              "$ref": "resource-filter.schema.json"
            }
          },
          "required": [
            "kind",
            "filter"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
