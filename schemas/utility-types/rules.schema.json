{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/utility-types/rules.schema.json",
  "title": "Character Rules",
  "description": "Schema for archive-authored character rules and effect templates",
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "effectTemplate": {
          "$ref": "#/$defs/effectTemplate"
        },
        "startLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "effectTemplate",
        "startLevel"
      ],
      "additionalProperties": false
    },
    "effectTemplate": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "addArmorProficiency",
            "addArmorGroupProficiency",
            "addAction",
            "addFeat",
            "addFeature",
            "addLanguage",
            "addPlaceholder",
            "addSavingThrow",
            "addSkillIncrease",
            "addLoreSkillIncrease",
            "addWeaponProficiency",
            "addWeaponGroupProficiency",
            "addRollModifier",
            "addWeaponCriticalSpecialization",
            "addLookupEntryEffect",
            "addSpellcastingEntry",
            "addSpellSlot",
            "addSpellcastingProficiency",
            "addSpeedModifier",
            "addAssurance",
            "addTerrainStalker"
          ]
        },
        "inputRecipes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputRecipe"
          },
          "default": []
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "inputRecipe": {
      "type": "object",
      "properties": {
        "inputName": {
          "type": "string"
        },
        "expectedValue": {
          "$ref": "#/$defs/expectedValue"
        }
      },
      "required": ["inputName", "expectedValue"],
      "additionalProperties": false
    },
    "expectedValue": {
      "type": "object",
      "properties": {
        "parameterType": {
          "type": "string",
          "enum": [
            "uuid",
            "string",
            "int",
            "bool",
            "featId",
            "actionId",
            "resourceReference",
            "proficiencyRank",
            "savingThrow",
            "skill",
            "weaponGroup",
            "weaponDesignation",
            "characterFeature"
          ]
        },
        "valueFromSource": {
          "$ref": "#/$defs/source"
        }
      },
      "required": ["parameterType", "valueFromSource"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": { "$ref": "#/$defs/literalValue" }
          },
          "required": ["literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lookupByName": { "type": "string", "minLength": 1 }
          },
          "required": ["lookupByName"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "selection": { "$ref": "#/$defs/selection" }
          },
          "required": ["selection"],
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "lookupName": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/literalValue" }
        }
      },
      "required": ["id", "lookupName", "options"],
      "additionalProperties": false
    },
    "literalValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": ["uuid"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "string": {
              "type": "string"
            }
          },
          "required": ["string"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "int": {
              "type": "integer"
            }
          },
          "required": ["int"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": ["bool"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "featId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": ["featId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": ["actionId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resourceReference": {
              "$ref": "#/$defs/resourceReference"
            }
          },
          "required": ["resourceReference"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "proficiencyRank": {
              "$ref": "proficiency-rank.schema.json"
            }
          },
          "required": ["proficiencyRank"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "savingThrow": {
              "type": "string",
              "enum": ["fortitude", "reflex", "will", "perception"]
            }
          },
          "required": ["savingThrow"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "skill": { "$ref": "skill.schema.json" }
          },
          "required": ["skill"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "weaponGroup": {
              "type": "string",
              "enum": ["any", "sword", "brawling", "flail", "knife", "club", "dart", "spear", "axe", "polearm", "hammer", "pick", "shield", "bow"]
            }
          },
          "required": ["weaponGroup"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "weaponDesignation": { "type": "string", "minLength": 1 }
          },
          "required": ["weaponDesignation"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "characterFeature": { "$ref": "#/$defs/characterFeatureLiteral" }
          },
          "required": ["characterFeature"],
          "additionalProperties": false
        }
      ]
    },
    "characterFeatureLiteral": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "parent": { "$ref": "#/$defs/resourceReference" },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "book": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 20 },
        "traits": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      },
      "required": ["id", "parent", "name", "publisher", "book", "level", "traits", "description", "rules"],
      "additionalProperties": false
    },
    "resourceReference": {
      "type": "string",
      "pattern": "^omen://\\S+$",
      "description": "A canonical OmenPath URI, optionally qualified with ?source=<publication-id>."
    },
    "prerequisite": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hasClassTrait": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["hasClassTrait"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": ["hasLevel"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAncestryWithName": { "type": "string", "minLength": 1 }
          },
          "required": ["hasAncestryWithName"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasClassWithName": { "type": "string", "minLength": 1 }
          },
          "required": ["hasClassWithName"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasTrait": { "type": "string", "minLength": 1 }
          },
          "required": ["hasTrait"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatWithName": {
              "type": "string"
            }
          },
          "required": ["hasFeatWithName"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasFeatureWithName": {
              "type": "string"
            }
          },
          "required": ["hasFeatureWithName"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasResourceWithName": { "type": "string", "minLength": 1 }
          },
          "required": ["hasResourceWithName"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAttribute": {
              "type": "object",
              "properties": {
                "attribute": {
                  "$ref": "attribute.schema.json"
                },
                "score": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                }
              },
              "required": ["attribute", "score"],
              "additionalProperties": false
            }
          },
          "required": ["hasAttribute"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAttributeModifier": {
              "type": "object",
              "properties": {
                "attribute": { "$ref": "attribute.schema.json" },
                "modifier": { "type": "integer", "minimum": -5, "maximum": 20 }
              },
              "required": ["attribute", "modifier"],
              "additionalProperties": false
            }
          },
          "required": ["hasAttributeModifier"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSkillProficiency": {
              "type": "object",
              "properties": {
                "skill": {
                  "$ref": "skill.schema.json"
                },
                "proficiency": {
                  "$ref": "proficiency-rank.schema.json"
                }
              },
              "required": ["skill", "proficiency"],
              "additionalProperties": false
            }
          },
          "required": ["hasSkillProficiency"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSavingThrowProficiency": {
              "type": "object",
              "properties": {
                "savingThrow": { "$ref": "saving-throw.schema.json" },
                "proficiency": { "$ref": "proficiency-rank.schema.json" }
              },
              "required": ["savingThrow", "proficiency"],
              "additionalProperties": false
            }
          },
          "required": ["hasSavingThrowProficiency"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasSpellcasting": { "type": "boolean", "const": true }
          },
          "required": ["hasSpellcasting"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasAccess": { "type": "string", "minLength": 1 }
          },
          "required": ["hasAccess"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "items": { "$ref": "#/$defs/prerequisite" },
              "minItems": 1
            }
          },
          "required": ["allOf"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "anyOf": {
              "type": "array",
              "items": { "$ref": "#/$defs/prerequisite" },
              "minItems": 1
            }
          },
          "required": ["anyOf"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unsupported": { "type": "string", "minLength": 1 }
          },
          "required": ["unsupported"],
          "additionalProperties": false
        }
      ]
    }
  }
}
