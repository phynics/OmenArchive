{
  "version": 2,
  "publication": {
    "path": "src/{publication}/publication.yml",
    "schema": "publication.schema.json"
  },
  "families": [
    {
      "id": "action",
      "directory": "action",
      "layout": "flat",
      "schema": "character-action.schema.json",
      "identity": {
        "host": "action",
        "includesOwner": false
      }
    },
    {
      "id": "spell",
      "directory": "spell",
      "layout": "flat",
      "schema": "character-spell.schema.json",
      "identity": {
        "host": "spell",
        "includesOwner": false
      }
    },
    {
      "id": "item",
      "directory": "item",
      "layout": "flat",
      "schema": "character-item.schema.json",
      "identity": {
        "host": "item",
        "includesOwner": false
      }
    },
    {
      "id": "background",
      "directory": "background",
      "layout": "flat",
      "schema": "character-background.schema.json",
      "identity": {
        "host": "background",
        "includesOwner": false
      }
    },
    {
      "id": "feat",
      "directory": "feat",
      "layout": "flat",
      "schema": "character-feat.schema.json",
      "identity": {
        "host": "feat",
        "includesOwner": false
      }
    },
    {
      "id": "ancestry",
      "directory": "ancestry",
      "layout": "bundle",
      "schema": "character-ancestry.schema.json",
      "children": [
        {
          "directory": "features",
          "layout": "flat",
          "schema": "character-feature.schema.json",
          "collection": "features"
        }
      ],
      "identity": {
        "host": "ancestry",
        "includesOwner": true
      }
    },
    {
      "id": "class",
      "directory": "class",
      "layout": "bundle",
      "schema": "character-class.schema.json",
      "children": [
        {
          "directory": "features",
          "layout": "flat",
          "schema": "character-feature.schema.json",
          "collection": "features"
        },
        {
          "directory": "schools",
          "layout": "flat",
          "schema": "character-feature.schema.json",
          "collection": "schools"
        },
        {
          "directory": "basic-lessons",
          "layout": "flat",
          "schema": "character-feature.schema.json",
          "collection": "basic-lessons"
        },
        {
          "directory": "greater-lessons",
          "layout": "flat",
          "schema": "character-feature.schema.json",
          "collection": "greater-lessons"
        },
        {
          "directory": "major-lessons",
          "layout": "flat",
          "schema": "character-feature.schema.json",
          "collection": "major-lessons"
        }
      ],
      "allowsCustomChildren": true,
      "customChildSchema": "character-feature.schema.json",
      "identity": {
        "host": "class",
        "includesOwner": true
      }
    },
    {
      "id": "archetype",
      "directory": "archetype",
      "layout": "bundle",
      "schema": "character-archetype.schema.json",
      "children": [
        {
          "directory": "feats",
          "layout": "flat",
          "schema": "character-feat.schema.json",
          "collection": "feats"
        }
      ],
      "identity": {
        "host": "archetype",
        "includesOwner": true
      }
    },
    {
      "id": "domain",
      "directory": "domain",
      "layout": "flat",
      "schema": "character-domain.schema.json",
      "identity": {
        "host": "domains",
        "includesOwner": false
      }
    },
    {
      "id": "companion",
      "directory": "companion",
      "layout": "flat",
      "schema": "character-companion.schema.json",
      "identity": {
        "host": "companion",
        "includesOwner": false
      }
    },
    {
      "id": "heritage",
      "directory": "heritage",
      "layout": "grouped",
      "schema": "character-heritage.schema.json",
      "identity": {
        "host": "heritage",
        "includesOwner": false
      }
    }
  ],
  "customGroups": [
    {
      "familyID": "class",
      "ownerPath": [
        "bard"
      ],
      "directory": "muses",
      "schema": "character-feature.schema.json",
      "collection": "muses"
    },
    {
      "familyID": "class",
      "ownerPath": [
        "cleric"
      ],
      "directory": "doctrines",
      "schema": "character-feature.schema.json",
      "collection": "doctrines"
    },
    {
      "familyID": "class",
      "ownerPath": [
        "druid"
      ],
      "directory": "orders",
      "schema": "character-feature.schema.json",
      "collection": "orders"
    },
    {
      "familyID": "class",
      "ownerPath": [
        "ranger"
      ],
      "directory": "hunters-edge",
      "schema": "character-feature.schema.json",
      "collection": "hunters-edge"
    },
    {
      "familyID": "class",
      "ownerPath": [
        "rogue"
      ],
      "directory": "rackets",
      "schema": "character-feature.schema.json",
      "collection": "rackets"
    },
    {
      "familyID": "class",
      "ownerPath": [
        "witch"
      ],
      "directory": "patrons",
      "schema": "character-feature.schema.json",
      "collection": "patrons"
    },
    {
      "familyID": "class",
      "ownerPath": [
        "wizard"
      ],
      "directory": "theses",
      "schema": "character-feature.schema.json",
      "collection": "theses"
    }
  ]
}
