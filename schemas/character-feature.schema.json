{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-feature.schema.json",
  "title": "Character Feature",
  "description": "Schema for a character feature in the game",
  "type": "object",
  "properties": {
    "sourceID": {
      "type": "string",
      "description": "The source system's stable record identifier"
    },
    "name": {
      "type": "string",
      "description": "Name of the character feature"
    },
    "source": {
      "$ref": "utility-types/content-source.schema.json"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Level of the character feature"
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of traits associated with this feature",
      "default": []
    },
    "action": {
      "$ref": "utility-types/action-primitive.schema.json"
    },
    "description": {
      "type": "string",
      "description": "Description of the character feature"
    },
    "grantedSpells": {
      "description": "Spells this feature grants: focus spells and focus cantrips join the class's focus source; known spells join its repertoire or spellbook, and the known-choice spells are one choice between them.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spell": {
            "type": "string",
            "pattern": "^omen://spell/[^/?]+(?:\\?source=[^/?]+)?$"
          },
          "grant": {
            "type": "string",
            "enum": [
              "focus",
              "focus-cantrip",
              "known",
              "known-choice"
            ]
          }
        },
        "required": [
          "spell",
          "grant"
        ],
        "additionalProperties": false
      }
    },
    "curriculum": {
      "description": "A wizard school's curriculum: the spells of each rank (0 for cantrips).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "spells": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^omen://spell/[^/?]+(?:\\?source=[^/?]+)?$"
            },
            "minItems": 1
          }
        },
        "required": [
          "rank",
          "spells"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "x-omen-ownership": "archive",
      "type": "array",
      "items": {
        "$ref": "utility-types/rules.schema.json#/$defs/rule"
      },
      "default": []
    },
    "mechanicsScope": {
      "x-omen-ownership": "archive",
      "type": "string",
      "enum": [
        "builder",
        "encounter",
        "mixed"
      ]
    },
    "unsupportedReason": {
      "x-omen-ownership": "archive",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "source",
    "description"
  ],
  "allOf": [
    {
      "$ref": "utility-types/mechanics-support.schema.json"
    }
  ]
}
