{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-feat.schema.json",
  "title": "Character Feat",
  "description": "Schema for a character feat in the game",
  "type": "object",
  "properties": {
    "foundryID": {
      "type": "string",
      "minLength": 1,
      "description": "Stable source-system identifier retained for import diagnostics"
    },
    "name": {
      "type": "string",
      "description": "Name of the feat",
      "minLength": 1
    },
    "attribution": { "$ref": "utility-types/attribution.schema.json" },
    "type": {
      "type": "string",
      "enum": ["general", "ancestry", "class", "skill", "archetype", "other"],
      "description": "Feat category/type, such as general, ancestry, class, or skill"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "alternateLevels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "rarity": {
      "$ref": "utility-types/rarity.schema.json"
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "description": "One list per feat: each prerequisite's text and, next to it, its typed form. A bare string is text with no typed form.",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "utility-types/rules.schema.json#/$defs/prerequisiteEntry" }
        ]
      },
      "default": []
    },
    "relatedArchetype": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "specialText": {
      "type": "string",
      "minLength": 1
    },
    "repeatPolicy": {
      "type": "object",
      "properties": {
        "maxCount": {
          "type": ["integer", "null"],
          "minimum": 2,
          "maximum": 20
        },
        "instanceLevelGates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instanceNumber": {
                "type": "integer",
                "minimum": 2
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": ["instanceNumber", "minimumLevel"],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "action": {
      "$ref": "utility-types/action-primitive.schema.json",
      "unevaluatedProperties": false
    },
    "rules": {
      "x-omen-ownership": "archive",
      "type": "array",
      "items": {
        "$ref": "utility-types/rules.schema.json#/$defs/rule"
      },
      "default": []
    },
    "mechanicsScope": {
      "x-omen-ownership": "archive",
      "type": "string",
      "enum": ["builder", "encounter", "mixed"]
    },
    "unsupportedReason": {
      "x-omen-ownership": "archive",
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object",
      "description": "The facts the record states about itself, which a rule can read: a name to a whole number, a flag, a term of a vocabulary, a reference to a record (omen://), or a list of these. The publication declares each fact for the record's collection in its facts; the archive check holds a value to its declaration.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "type": ["integer", "boolean", "string", "array"],
        "items": {
          "type": ["integer", "boolean", "string"]
        }
      }
    },
    "unsupportedCategory": {
      "x-omen-ownership": "archive",
      "description": "What the unapplied rules cost a player: numbers (a bonus, Speed, proficiency rank or skill is wrong or missing), choice (a choice the book allows can't be made), benefit (a benefit the book grants is not applied), text (the rule is in the description and the player applies it) or scope (a table or encounter concern a builder doesn't need). Required with unsupportedReason; the reason says what is missing in words. From format 6.",
      "type": "string",
      "enum": ["numbers", "choice", "benefit", "text", "scope"]
    }
  },
  "required": [
    "name",
    "type",
    "level",
    "rarity"
  ],
  "allOf": [
    {
      "$ref": "utility-types/mechanics-support.schema.json"
    }
  ],
  "additionalProperties": false
}
