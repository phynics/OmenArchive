{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-feat.schema.json",
  "title": "Character Feat",
  "description": "Schema for a character feat in the game",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the feat"
    },
    "source": {
      "$ref": "utility-types/content-source.schema.json"
    },
    "type": {
      "type": "string",
      "enum": ["general", "ancestry", "class", "skill", "archetype", "other"],
      "description": "Feat category/type, such as general, ancestry, class, or skill"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "alternateLevels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "rarity": {
      "$ref": "utility-types/rarity.schema.json"
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "description": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "relatedArchetype": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "specialText": {
      "type": "string"
    },
    "repeatPolicy": {
      "type": "object",
      "properties": {
        "maxCount": {
          "type": ["integer", "null"],
          "minimum": 2
        },
        "instanceLevelGates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instanceNumber": {
                "type": "integer",
                "minimum": 2
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": ["instanceNumber", "minimumLevel"],
            "additionalProperties": false
          },
          "default": []
        },
        "duplicateSelectionRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lookupName": {
                "type": "string"
              },
              "payloadType": {
                "type": "string"
              }
            },
            "required": ["lookupName", "payloadType"],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": ["instanceLevelGates", "duplicateSelectionRules"],
      "additionalProperties": false
    },
    "action": {
      "$ref": "utility-types/action-primitive.schema.json"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "utility-types/rules.schema.json#/$defs/rule"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "source",
    "type",
    "level",
    "rarity",
    "description"
  ]
}
