{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-ancestry.schema.json",
  "title": "Character Ancestry",
  "description": "Schema for a character ancestry in the game",
  "type": "object",
  "$defs": {
    "attributeModification": {
      "type": "string",
      "enum": ["boost", "flaw", "neutral"],
      "default": "neutral"
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the ancestry",
      "minLength": 1
    },
    "attribution": { "$ref": "utility-types/attribution.schema.json" },
    "description": {
      "type": "string",
      "description": "Description text of the ancestry",
      "minLength": 1
    },
    "rarity": {
      "$ref": "utility-types/rarity.schema.json"
    },
    "hitPoints": {
      "type": "integer",
      "minimum": 6,
      "maximum": 12,
      "description": "Base hit points granted by this ancestry"
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "List of traits associated with this ancestry"
    },
    "attributes": {
      "type": "object",
      "description": "Attribute modifications available for this ancestry",
      "properties": {
        "freeBoosts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "Number of free attribute boosts available"
        },
        "strength": {
          "$ref": "#/$defs/attributeModification"
        },
        "dexterity": {
          "$ref": "#/$defs/attributeModification"
        },
        "constitution": {
          "$ref": "#/$defs/attributeModification"
        },
        "intelligence": {
          "$ref": "#/$defs/attributeModification"
        },
        "wisdom": {
          "$ref": "#/$defs/attributeModification"
        },
        "charisma": {
          "$ref": "#/$defs/attributeModification"
        }
      },
      "minProperties": 1,
      "additionalProperties": false,
      "required": ["freeBoosts", "strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Languages automatically known by this ancestry",
      "default": []
    },
    "languageAccess": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Languages that can be chosen as additional languages",
      "default": []
    },
    "additionalLanguages": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of additional languages that can be chosen",
      "maximum": 10
    },
    "speed": {
      "type": "integer",
      "minimum": 15,
      "maximum": 40,
      "description": "Base speed in feet"
    },
    "vision": {
      "type": "string",
      "enum": [
        "normal",
        "low-light",
        "darkvision"
      ],
      "description": "Type of vision possessed by this ancestry"
    },
    "size": {
      "type": "string",
      "enum": [
        "tiny",
        "small",
        "medium",
        "large",
        "huge",
        "gargantuan"
      ],
      "description": "Size category of this ancestry"
    },
    "rules": {
      "x-omen-ownership": "archive",
      "description": "Inline rules, applied at 1st level. Larger mechanics go in feature records.",
      "type": "array",
      "items": {
        "$ref": "utility-types/rules.schema.json#/$defs/rule"
      },
      "default": []
    },
    "mechanicsScope": {
      "x-omen-ownership": "archive",
      "type": "string",
      "enum": ["builder", "encounter", "mixed"]
    },
    "unsupportedReason": {
      "x-omen-ownership": "archive",
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object",
      "description": "The facts the record states about itself, which a rule can read: a name to a whole number, a flag, a term of a vocabulary, a reference to a record (omen://), or a list of these. The publication declares each fact for the record's collection in its facts; the archive check holds a value to its declaration.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "type": ["integer", "boolean", "string", "array"],
        "items": {
          "type": ["integer", "boolean", "string"]
        }
      }
    },
    "unsupportedCategory": {
      "x-omen-ownership": "archive",
      "description": "What the unapplied rules cost a player: numbers (a bonus, Speed, proficiency rank or skill is wrong or missing), choice (a choice the book allows can't be made), benefit (a benefit the book grants is not applied), text (the rule is in the description and the player applies it) or scope (a table or encounter concern a builder doesn't need). Required with unsupportedReason; the reason says what is missing in words. From format 6.",
      "type": "string",
      "enum": ["numbers", "choice", "benefit", "text", "scope"]
    }
  },
  "required": [
    "name",
    "description",
    "rarity",
    "hitPoints",
    "traits",
    "attributes",
    "speed",
    "vision",
    "size",
    "languages",
    "additionalLanguages"
  ],
  "allOf": [
    {
      "$ref": "utility-types/mechanics-support.schema.json"
    }
  ],
  "additionalProperties": false
}
