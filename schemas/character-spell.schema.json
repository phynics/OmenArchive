{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-spell.schema.json",
  "title": "Character Spell",
  "description": "Source-independent spell contract for ordinary, cantrip, focus, and ritual spells.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "source": { "$ref": "utility-types/content-source.schema.json" },
    "sourceID": { "type": "string" },
    "rank": { "type": "integer", "minimum": 0, "maximum": 10 },
    "category": { "type": "string", "enum": ["spell", "cantrip", "focus", "ritual"] },
    "traditions": { "type": "array", "items": { "type": "string", "enum": ["arcane", "divine", "occult", "primal"] } },
    "rarity": { "$ref": "utility-types/rarity.schema.json" },
    "traits": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "action": { "$ref": "utility-types/action-primitive.schema.json" },
    "defense": {
      "type": "object",
      "properties": {
        "attack": { "type": "boolean" },
        "passive": { "type": "string" },
        "save": { "type": "string", "enum": ["fortitude", "reflex", "will", "perception"] },
        "basic": { "type": "boolean" },
        "counteraction": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "damage": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "formula": { "type": "string" },
            "type": { "type": "string" },
            "category": { "type": "string" },
            "kinds": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "time": { "type": "string" },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "heightening": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["fixed", "interval"] },
        "interval": { "type": "integer", "minimum": 1 },
        "damage": { "type": "object", "patternProperties": { "^.*$": { "type": "string" } }, "additionalProperties": false },
        "levels": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "range": { "type": "string" },
                "target": { "type": "string" },
                "area": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "range": { "type": "string" },
    "target": { "type": "string" },
    "area": { "type": "string" },
    "duration": { "type": "string" },
    "cost": { "type": "string" },
    "requirements": { "type": "string" },
    "mechanicsScope": {
    "x-omen-ownership": "archive", "type": "string", "enum": ["builder", "encounter", "mixed"] },
    "unsupportedReason": {
  "x-omen-ownership": "archive", "type": "string", "minLength": 1 }
  },
  "required": ["name", "source", "rank", "category", "traditions", "rarity", "traits", "description"],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "utility-types/mechanics-support.schema.json"
    }
  ]
}
