{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-spell.schema.json",
  "title": "Character Spell",
  "description": "Source-independent spell contract for ordinary, cantrip, focus, and ritual spells.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "attribution": { "$ref": "utility-types/attribution.schema.json" },
    "foundryID": { "type": "string", "minLength": 1 },
    "rank": { "type": "integer", "minimum": 0, "maximum": 10 },
    "category": { "type": "string", "enum": ["spell", "cantrip", "focus", "ritual"] },
    "traditions": { "type": "array", "items": { "type": "string", "enum": ["arcane", "divine", "occult", "primal"] } },
    "rarity": { "$ref": "utility-types/rarity.schema.json" },
    "traits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "minLength": 1 },
    "action": { "$ref": "utility-types/action-primitive.schema.json" },
    "defense": {
      "type": "object",
      "properties": {
        "attack": { "type": "boolean" },
        "passive": { "type": "string" },
        "save": { "type": "string", "enum": ["fortitude", "reflex", "will"] },
        "basic": { "type": "boolean" },
        "counteraction": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "damage": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "formula": { "type": "string" },
            "type": { "type": "string" },
            "category": { "type": "string" },
            "kinds": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "time": { "type": "string" },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "heightening": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["fixed", "interval"] },
        "interval": { "type": "integer", "minimum": 1, "maximum": 10 },
        "damage": { "type": "object", "patternProperties": { "^.*$": { "type": "string" } }, "additionalProperties": false },
        "levels": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "description": { "type": "string", "minLength": 1 },
                "range": { "type": "string" },
                "target": { "type": "string" },
                "area": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "range": { "type": "string" },
    "target": { "type": "string" },
    "area": { "type": "string" },
    "duration": { "type": "string" },
    "cost": { "type": "string" },
    "requirements": { "type": "string" },
    "mechanicsScope": {
    "x-omen-ownership": "archive", "type": "string", "enum": ["builder", "encounter", "mixed"] },
    "unsupportedReason": {
  "x-omen-ownership": "archive", "type": "string", "minLength": 1 },
    "facts": {
      "type": "object",
      "description": "The facts the record states about itself, which a rule can read: a name to a whole number, a flag, a term of a vocabulary, a reference to a record (omen://), or a list of these. The publication declares each fact for the record's collection in its facts; the archive check holds a value to its declaration.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "type": ["integer", "boolean", "string", "array"],
        "items": {
          "type": ["integer", "boolean", "string"]
        }
      }
    },
    "unsupportedCategory": {
      "x-omen-ownership": "archive",
      "description": "What the unapplied rules cost a player: numbers (a bonus, Speed, proficiency rank or skill is wrong or missing), choice (a choice the book allows can't be made), benefit (a benefit the book grants is not applied), text (the rule is in the description and the player applies it) or scope (a table or encounter concern a builder doesn't need). Required with unsupportedReason; the reason says what is missing in words. From format 6.",
      "type": "string",
      "enum": ["numbers", "choice", "benefit", "text", "scope"]
    }
  },
  "required": ["name", "rank", "category", "rarity", "description"],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "utility-types/mechanics-support.schema.json"
    }
  ]
}
