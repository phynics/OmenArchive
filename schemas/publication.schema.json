{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/publication.schema.json",
  "title": "OmenArchive Publication",
  "description": "Metadata that identifies and orders one archive publication.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "publisher": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "published": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "required": ["id", "publisher", "title", "published"],
  "additionalProperties": false
}
