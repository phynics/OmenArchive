{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/publication.schema.json",
  "title": "OmenArchive Publication",
  "description": "Metadata that identifies and orders one archive publication.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "publisher": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "published": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "mechanicsModules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "moduleID": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The short name files use for this module in effect and type names (core/add-feat)."
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "moduleID",
          "alias",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "externalRecords": {
      "type": "array",
      "description": "Records that rules refer to but no publication of the archive holds, as canonical omen:// paths. A reference to one of them is not a miss.",
      "items": {
        "type": "string",
        "pattern": "^omen://[a-z0-9-]+(/[a-z0-9-]+)+\\?source=[a-z0-9-]+$"
      }
    }
  },
  "required": [
    "id",
    "publisher",
    "title",
    "published",
    "mechanicsModules"
  ],
  "additionalProperties": false
}
