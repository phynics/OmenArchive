{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-rule.schema.json",
  "title": "OmenArchive Rule",
  "description": "A general rule such as cover, flanking or degrees of success: reference text a description can link to. It carries no mechanics.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "attribution": { "$ref": "utility-types/attribution.schema.json" },
    "description": { "type": "string" }
  },
  "required": ["name", "description"],
  "additionalProperties": false
}
