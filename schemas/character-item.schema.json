{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-item.schema.json",
  "title": "Character Item",
  "description": "Canonical equipment record. The type discriminator selects one subtype payload while physical fields stay shared.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "attribution": { "$ref": "utility-types/attribution.schema.json" },
    "foundryID": { "type": "string", "minLength": 1 },
    "formulaFamily": {
      "type": "string",
      "minLength": 1,
      "description": "The alchemical formula the item is made from: each grade of an item shares one family. Matching is exact."
    },
    "type": {
      "type": "string",
      "enum": ["equipment", "weapon", "armor", "shield", "consumable", "container", "treasure", "kit"]
    },
    "level": { "type": "integer", "minimum": 0, "maximum": 30 },
    "rarity": { "$ref": "utility-types/rarity.schema.json" },
    "traits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "minLength": 1 },
    "physical": {
      "type": "object",
      "properties": {
        "bulk": { "type": "string", "minLength": 1 },
        "price": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "hardness": { "type": "integer", "minimum": 0, "maximum": 100 },
        "hitPoints": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "usage": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "details": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "equipment": {
            "type": "object",
            "properties": { "category": { "type": "string" } },
            "additionalProperties": false
          } },
          "required": ["equipment"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "weapon": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "group": { "type": "string" },
              "damage": { "type": "string" },
              "range": { "type": "integer", "minimum": 0 },
              "reload": { "type": "string" }
            },
            "additionalProperties": false
          } },
          "required": ["weapon"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "armor": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "acBonus": { "type": "integer" },
              "dexterityCap": { "type": "integer", "minimum": 0 },
              "checkPenalty": { "type": "integer" },
              "speedPenalty": { "type": "integer" },
              "strength": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          } },
          "required": ["armor"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "shield": {
            "type": "object",
            "properties": {
              "acBonus": { "type": "integer" },
              "hardness": { "type": "integer", "minimum": 0 },
              "hitPoints": { "type": "integer", "minimum": 0 },
              "speedPenalty": { "type": "integer" }
            },
            "additionalProperties": false
          } },
          "required": ["shield"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "consumable": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "activation": { "type": "string" },
              "uses": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          } },
          "required": ["consumable"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "container": {
            "type": "object",
            "properties": {
              "capacity": { "type": "string" },
              "bulkReduction": { "type": "string" }
            },
            "additionalProperties": false
          } },
          "required": ["container"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "treasure": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "value": { "type": "string" }
            },
            "additionalProperties": false
          } },
          "required": ["treasure"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kit": {
            "type": "object",
            "properties": {
              "contents": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          } },
          "required": ["kit"],
          "additionalProperties": false
        }
      ]
    },
    "rules": {
      "x-omen-ownership": "archive",
      "type": "array",
      "items": { "$ref": "utility-types/rules.schema.json#/$defs/rule" },
      "default": []
    },
    "mechanicsScope": {
      "x-omen-ownership": "archive",
      "type": "string",
      "enum": ["builder", "encounter", "mixed"]
    },
    "unsupportedReason": {
      "x-omen-ownership": "archive",
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object",
      "description": "The facts the record states about itself, which a rule can read: a name to a whole number, a flag, a term of a vocabulary, a reference to a record (omen://), or a list of these. The publication declares each fact for the record's collection in its facts; the archive check holds a value to its declaration.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "type": ["integer", "boolean", "string", "array"],
        "items": {
          "type": ["integer", "boolean", "string"]
        }
      }
    },
    "unsupportedCategory": {
      "x-omen-ownership": "archive",
      "description": "What the unapplied rules cost a player: numbers (a bonus, Speed, proficiency rank or skill is wrong or missing), choice (a choice the book allows can't be made), benefit (a benefit the book grants is not applied), text (the rule is in the description and the player applies it) or scope (a table or encounter concern a builder doesn't need). Required with unsupportedReason; the reason says what is missing in words. From format 6.",
      "type": "string",
      "enum": ["numbers", "choice", "benefit", "text", "scope"]
    }
  },
  "required": ["name", "type", "level", "rarity", "physical"],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "utility-types/mechanics-support.schema.json"
    }
  ]
}
