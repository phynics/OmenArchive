{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phynics/OmenArchive/refs/heads/main/schemas/character-archetype.schema.json",
  "title": "OmenArchive Archetype",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "attribution": { "$ref": "utility-types/attribution.schema.json" },
    "description": { "type": "string", "minLength": 1 },
    "entryFeat": { "type": "string", "pattern": "^omen://archetype/[^/]+/feats/[^/?]+(?:\\?source=[^/?]+)?$" },
    "progression": {
      "type": "object",
      "properties": {
        "requires": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" } },
        "countsFeatsFrom": { "type": "array", "items": { "type": "string" } },
        "dedicationLockExceptions": {
          "type": "array", "items": { "type": "string" },
          "description": "Archetypes whose dedication can be taken while this archetype has fewer than three feats."
        },
        "dedicationLockChoice": {
          "type": "string", "pattern": "^\\$\\.",
          "description": "A choice the dedication asks, whose answer names one more archetype whose dedication can be taken early (a pledge)."
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "description": "The facts the record states about itself, which a rule can read: a name to a whole number, a flag, a term of a vocabulary, a reference to a record (omen://), or a list of these. The publication declares each fact for the record's collection in its facts; the archive check holds a value to its declaration.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "type": ["integer", "boolean", "string", "array"],
        "items": {
          "type": ["integer", "boolean", "string"]
        }
      }
    }
  },
  "required": ["name", "description", "entryFeat"],
  "additionalProperties": false
}
